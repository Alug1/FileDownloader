<Window x:Class="ClassLibrary1.Element.UserControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClassLibrary1.Element"
             mc:Ignorable="d" Width="320" Height="200" ResizeMode="NoResize">
    <Grid Margin="0,0,0,1">
        <Label x:Name="lbLogin" Content="Логин" Margin="14,0,0,129" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="44"/>
        <Label x:Name="lbPassword" Content="Пароль" HorizontalAlignment="Left" Margin="14,0,0,75" Height="26" VerticalAlignment="Bottom"/>
        <TextBox x:Name="tbLogin" Margin="0,0,23,129" TextWrapping="Wrap" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="214" Initialized="tbLogin_Initialized"/>
        <TextBox x:Name="tbPassword" Margin="0,0,23,75" TextWrapping="Wrap" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="214"/>
        <Button x:Name="btLoginOk" Content="Ок" Margin="0,0,23,14" Click="btLoginOk_Click" HorizontalAlignment="Right" Width="53" Height="20" VerticalAlignment="Bottom"/>
        <CheckBox x:Name="cbSave" Content="Запомнить данные" HorizontalAlignment="Left" Margin="14,0,0,14" Height="15" VerticalAlignment="Bottom"/>

    </Grid>
</Window>
