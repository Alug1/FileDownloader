<Window x:Class="ClassLibrary1.Element.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClassLibrary1.Element"
             mc:Ignorable="d" Height="360" Width="650" ResizeMode="NoResize">
    <Grid Margin="0,0,39,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="tbSearch" Margin="25,74,0,0" TextWrapping="Wrap" Height="29" VerticalAlignment="Top" HorizontalAlignment="Left" Width="457"/>
        <Button x:Name="searchFamily" Content="Поиск" Margin="0,74,2,0" Height="29" VerticalAlignment="Top" HorizontalAlignment="Right" Width="101" Click="searchFamily_ClickAsync"/>
        <Button x:Name="cancelButton" Content="Отмена" Margin="0,0,5,23" Click="Button_Click" Height="31" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="142"/>
        <Button x:Name="openFamily" Content="Открыть семейство в Revit" HorizontalAlignment="Left" Margin="25,0,0,23" Width="226" Height="31" VerticalAlignment="Bottom" Click="openFamily_Click"/>
        <Label Content="Введите название семейства" Margin="25,43,0,0" AutomationProperties.Name="Введите наименование " Height="27" VerticalAlignment="Top" HorizontalAlignment="Left" Width="301"/>
        <Image x:Name="imageFamily" Margin="25,142,0,0" Height="107" VerticalAlignment="Top" HorizontalAlignment="Left" Width="123"/>
        <Label x:Name="nameFamily" Content="Наименование семейства" Margin="193,141,0,0" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left" Width="346"/>
        <Label Content="Дата создания:" Margin="193,172,0,0" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left" Width="107"/>
        <Label Content="Вес:" Margin="193,198,0,0" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left" Width="57"/>
        <Label x:Name="creatureDate" Content="" Margin="292,172,0,0" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left" Width="148"/>
        <Label x:Name="weightFile" Content="" Margin="229,198,0,0" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left" Width="158"/>
        <Button x:Name="btUserName" Content="Пользователь" Margin="0,13,4,0" VerticalAlignment="Top" Click="btUserName_Click" Height="28" HorizontalAlignment="Right" Width="100"/>

    </Grid>
</Window>
